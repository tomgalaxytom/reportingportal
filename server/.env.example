# Environment: local | prodlocal | production
APP_ENV=local
HOST=0.0.0.0
PORT=8000

# PostgreSQL Connection String (Loaded strictly from environment)
DATABASE_URL=postgresql://username:password@localhost:5432/reportingportal

# Application Secret Key (Used for sessions / JWT)
SECRET_KEY=replace-with-your-secure-random-secret-key

# Comma-separated CORS origins or *
CORS_ORIGINS=*
